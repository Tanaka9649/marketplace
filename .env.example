# ─────────────────────────────────────────────────────────────
# DM Empresarial · Landing de Gestão de Marketplaces
# Copie para .env.local (local) ou cadastre na Vercel:
# Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# URL pública do site (usada em SEO, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# WhatsApp comercial da DM — somente números, com DDI + DDD
# Exemplo de formato: 5534999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Mensagem inicial padrão do WhatsApp (opcional)
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Quero saber mais sobre a gestão de marketplaces da DM Empresarial.

# Recebimento de leads (opcional). Quando preenchido, o formulário envia
# os dados (JSON via POST) para este endereço: n8n, Make, Zapier, CRM etc.
# Fica apenas no servidor — não é exposto no navegador.
LEAD_WEBHOOK_URL=
# Token opcional enviado no cabeçalho "Authorization: Bearer <token>"
LEAD_WEBHOOK_TOKEN=

# Analytics (opcionais — só carregam quando preenchidos)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
